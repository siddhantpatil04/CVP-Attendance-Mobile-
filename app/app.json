{
  "expo": {
    "name": "CVP Attendance",
    "slug": "cvp-attendance",
    "scheme": "cvpattendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3c3aed02-d93f-4cf1-bb14-3f6bed069061",
      "checkAutomatically": "ON_LOAD"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.cvpatil.attendance",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": true }
      }
    },
    "android": {
      "package": "com.cvpatil.attendance",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "CVP Attendance uses the camera to capture your site selfie for attendance.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CVP Attendance records your location only at the moment you check in or check out."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-font",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ],
    "extra": {
      "eas": {
        "projectId": "3c3aed02-d93f-4cf1-bb14-3f6bed069061"
      }
    },
    "web": {
      "name": "CVP Attendance",
      "shortName": "CVP Attendance",
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "themeColor": "#06253F",
      "backgroundColor": "#F5F8FC",
      "description": "C. V. Patil & Associates - employee attendance (desktop + mobile)"
    }
  }
}
