{
  "name": "cvp-attendance-desktop",
  "version": "1.0.0",
  "description": "CVP Attendance desktop app (Windows)",
  "author": "C. V. Patil & Associates",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.cvpatil.attendance.desktop",
    "productName": "CVP Attendance",
    "files": [
      "main.js",
      "app-config.json",
      "web/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  }
}
